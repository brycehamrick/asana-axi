{
  "name": "asana-axi",
  "version": "1.0.0",
  "description": "Agent-ergonomic Asana CLI over the REST API, with token-efficient TOON output and idempotent mutations.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brycehamrick/asana-axi.git"
  },
  "homepage": "https://github.com/brycehamrick/asana-axi#readme",
  "keywords": [
    "asana",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "asana-axi": "dist/bin/asana-axi.js"
  },
  "files": [
    "dist",
    "skills/asana-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "skill:check": "node -e \"require('node:fs').accessSync('skills/asana-axi/SKILL.md')\"",
    "dev": "tsx src/bin/asana-axi.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
