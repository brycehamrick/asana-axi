# Optional local defaults for asana-axi. Copy to .env (gitignored).
# Real environment variables always win over values in this file.

# Required: personal access token from https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=

# Optional: pin a default workspace and project GID so --workspace/--project
# flags can be omitted. Find GIDs with `asana-axi me`, `workspace list`,
# `project list`.
ASANA_WORKSPACE_ID=
ASANA_PROJECT_ID=
